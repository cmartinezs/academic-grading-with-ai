{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-grading-with-ai/schemas/results/1.0.0",
  "title": "Canonical results",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sectionId", "results"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sectionId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["studentId", "assessmentId", "attemptId", "status", "components", "evidenceRefs"],
        "properties": {
          "studentId": { "type": "string", "pattern": "^stu_[A-Za-z0-9]{1,64}$" },
          "assessmentId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "attemptId": { "type": "string", "pattern": "^att_[A-Za-z0-9]{1,64}$" },
          "status": { "type": "string", "minLength": 1 },
          "score": { "type": ["number", "null"] },
          "grade": { "type": ["number", "null"] },
          "components": { "type": "array" },
          "feedback": { "type": ["string", "null"] },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
