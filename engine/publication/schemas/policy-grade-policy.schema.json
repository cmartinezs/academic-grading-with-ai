{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-grading-with-ai/schemas/policy/grade-policy-effective/1.0.0",
  "title": "Canonical effective policy (grade-policy-engine)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policySchemaVersion",
    "mode",
    "calculationAuthority",
    "policyId",
    "policyVersion",
    "engineVersion",
    "policyHash",
    "policy"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "policySchemaVersion": { "type": "string", "minLength": 1 },
    "mode": { "const": "grade-policy-effective" },
    "calculationAuthority": { "const": "grade-policy-engine" },
    "policyId": { "type": "string", "minLength": 1 },
    "policyVersion": { "type": "string", "minLength": 1 },
    "engineVersion": { "type": "string", "minLength": 1 },
    "policyHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policy": { "type": "object" }
  }
}
