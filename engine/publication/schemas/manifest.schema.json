{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academic-grading-with-ai/schemas/manifest/1.0.0",
  "title": "Publication snapshot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sectionId",
    "publicationId",
    "status",
    "contentHash",
    "engineVersion",
    "adapterVersion",
    "policySnapshotVersion",
    "createdAt",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "sectionId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "publicationId": { "type": "string", "pattern": "^pub_[A-Za-z0-9]{1,64}$" },
    "status": { "enum": ["draft", "reviewed", "approved"] },
    "supersedesPublicationId": { "type": ["string", "null"], "pattern": "^pub_[A-Za-z0-9]{1,64}$" },
    "correctsPublicationId": { "type": ["string", "null"], "pattern": "^pub_[A-Za-z0-9]{1,64}$" },
    "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "engineVersion": { "type": "string", "minLength": 1 },
    "adapterVersion": { "type": "string", "minLength": 1 },
    "policySnapshotVersion": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "approvedAt": { "type": ["string", "null"], "format": "date-time" },
    "approvedBy": { "type": ["string", "null"] },
    "files": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/fileEntry" }
    }
  },
  "$defs": {
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "audience", "size", "sha256"],
      "properties": {
        "classification": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
