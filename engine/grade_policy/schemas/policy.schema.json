{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grade-policy:policy:1.0.0",
  "title": "C2 Grade Policy Document",
  "description": "Schema-validated policy document. Semantic checks (operator catalog, phase/unit flow, DAG) are performed by the engine validator and are NOT expressible in JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "policyVersion",
    "engineMinVersion",
    "assessments",
    "stages",
    "resultStageId"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "policyId": { "type": "string", "minLength": 1 },
    "policyVersion": { "type": "string", "minLength": 1 },
    "engineMinVersion": { "type": "string", "minLength": 1 },
    "assessments": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "stages": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/stage" }
    },
    "resultStageId": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "operator", "inputs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "phase": {
          "enum": ["normalization", "aggregation", "adjustment", "conversion", "finalization"]
        },
        "operator": { "type": "string", "minLength": 1 },
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/input" }
        },
        "params": { "type": "object" },
        "missingPolicy": {
          "enum": [
            "fail",
            "excludeAndRenormalize",
            "zero",
            "minimumOutput",
            "pending",
            "notApplicable"
          ]
        },
        "condition": { "$ref": "#/$defs/condition" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "weight": {
          "type": ["number", "string"],
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "params"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      }
    }
  }
}
